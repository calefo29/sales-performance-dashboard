	measure '$ Average New/Renewal Deal Size' =
			
			VAR TotalBookings =
			    CALCULATE (
			        [$ Total Bookings],
			        KEEPFILTERS('Sales Transactions'[DealType] IN { "New Business", "Renewal" } )
			    )
			VAR TotalTransactions =
			    CALCULATE (
			        [# Total Deals],
			        KEEPFILTERS('Sales Transactions'[DealType] IN { "New Business", "Renewal" } )
			    )
			RETURN
			    DIVIDE (TotalBookings, TotalTransactions)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Measure 4 Average Deal Size
		lineageTag: 0c3a5758-1fae-494f-9a4b-d0892c9b3980

