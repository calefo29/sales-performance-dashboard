	measure '% Churn Rate (Transacting Accounts)' = DIVIDE([# Churned Transacting Accounts],[# Transacting Accounts])
		displayFolder: Detailed Analysis
		lineageTag: ca2e7cc6-4df3-4df7-bc65-16a19b5e6193

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Surviving' =
			
			VAR M = MAX ( 'MOB'[MOB] )
			VAR CohortStart = MIN ( Accounts[FirstPurchaseDate] )
			VAR LastData = CALCULATE ( MAX ( 'Date Table'[Date] ), REMOVEFILTERS () )
			VAR MaxObservable = DATEDIFF ( CohortStart, LastData, MONTH )
			VAR CohortSize = COUNTROWS ( Accounts )
			VAR ChurnedByM =
			    COUNTROWS (
			        FILTER (
			            Accounts,
			            NOT ISBLANK ( Accounts[ChurnDate] )
			                && DATEDIFF ( Accounts[FirstPurchaseDate], Accounts[ChurnDate], MONTH ) <= M
			        )
			    )
			RETURN
			    IF ( M <= MaxObservable, DIVIDE ( CohortSize - ChurnedByM, CohortSize ) )
		displayFolder: Detailed Analysis
		lineageTag: 25b8a9cc-6c0d-4659-908c-0b9afccc6428

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '@ Cohort Pos (by MOB)' =
			
			VAR Cur = [% Surviving]
			VAR Peers =
			    FILTER ( ALLSELECTED ( Accounts[# Cohort] ), NOT ISBLANK ( [% Surviving] ) )
			VAR PeerCount = COUNTROWS ( Peers )
			VAR MinV = MINX ( Peers, [% Surviving] )
			VAR MaxV = MAXX ( Peers, [% Surviving] )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Cur ), BLANK (),
			        PeerCount < 4, 0.9,
			        MaxV = MinV, 1,
			        DIVIDE ( Cur - MinV, MaxV - MinV )
			    )
		displayFolder: Detailed Analysis
		lineageTag: 028261b5-7478-4cfa-a717-9f5aa7526bfe

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '@ Cohort Color (by MOB)' =
			
			VAR Pos = [@ Cohort Pos (by MOB)]
			VAR Hex = "0123456789ABCDEF"
			VAR R = INT ( 10  + 245 * Pos )
			VAR G = INT ( 102 + 153 * Pos )
			VAR B = INT ( 194 + 61  * Pos )
			VAR RH = MID ( Hex, INT ( R / 16 ) + 1, 1 ) & MID ( Hex, MOD ( R, 16 ) + 1, 1 )
			VAR GH = MID ( Hex, INT ( G / 16 ) + 1, 1 ) & MID ( Hex, MOD ( G, 16 ) + 1, 1 )
			VAR BH = MID ( Hex, INT ( B / 16 ) + 1, 1 ) & MID ( Hex, MOD ( B, 16 ) + 1, 1 )
			RETURN
			    IF ( ISBLANK ( Pos ), BLANK (), "#" & RH & GH & BH )
		displayFolder: Detailed Analysis
		lineageTag: c0b6b75c-ffa1-46ae-b3c8-7663de0667c0

	measure '@ Cohort Font (by MOB)' =
			
			VAR Pos = [@ Cohort Pos (by MOB)]
			RETURN
			    IF ( ISBLANK ( Pos ), BLANK (), IF ( Pos < 0.45, "#FFFFFF", "#1B1B1B" ) )
		displayFolder: Detailed Analysis
		lineageTag: f87e8a78-4d01-40f7-9c1e-07bf7e647f56

	measure '# Surviving Accounts' =
			
			VAR M = MAX ( 'MOB'[MOB] )
			VAR CohortStart = MAX ( Accounts[FirstPurchaseDate] )
			VAR LastData = CALCULATE ( MAX ( 'Date Table'[Date] ), REMOVEFILTERS () )
			VAR MaxObservable = DATEDIFF ( CohortStart, LastData, MONTH )
			VAR CohortSize = COUNTROWS ( Accounts )
			VAR ChurnedByM =
			    CALCULATE (
			        COUNTROWS ( Accounts ),
			        Accounts[# Lifetime Months] <= M,
			        NOT ISBLANK ( Accounts[# Lifetime Months] )
			    )
			RETURN
			    IF ( M <= MaxObservable, CohortSize - ChurnedByM )
		formatString: 0
		displayFolder: Detailed Analysis
		lineageTag: a114b573-5e7d-41b9-ab87-d19cdd6e3d5d

	measure '# Accounts Lost' =
			
			VAR M = MAX ( 'MOB'[MOB] )
			VAR CohortStart = MAX ( Accounts[FirstPurchaseDate] )
			VAR LastData = CALCULATE ( MAX ( 'Date Table'[Date] ), REMOVEFILTERS () )
			VAR MaxObservable = DATEDIFF ( CohortStart, LastData, MONTH )
			VAR ChurnedByM =
			    CALCULATE (
			        COUNTROWS ( Accounts ),
			        Accounts[# Lifetime Months] <= M,
			        NOT ISBLANK ( Accounts[# Lifetime Months] )
			    )
			RETURN
			    IF ( M <= MaxObservable, ChurnedByM + 0 )
		formatString: 0
		displayFolder: Detailed Analysis
		lineageTag: fa02f238-1313-4ae2-bb2b-4fa79319a071

	measure '$ Quota per Account' =
			
			VAR QuartersInScope = COUNTROWS(SUMMARIZE('Date Table','Date Table'[FiscalYear],'Date Table'[FiscalQuarter]))
			RETURN
			    DIVIDE ( [$ Quota in Territory] * QuartersInScope, [# Total Accounts Base] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Detailed Analysis
		lineageTag: 3d444d1d-fe43-40c6-b55b-4d97698e551a

	measure '# Accounts in Territory' =
			
			CALCULATE (
			    COUNTROWS ( Accounts ),
			    TREATAS ( VALUES ( 'Sales Reps'[Territory] ), Accounts[Region] )
			)
		formatString: 0
		displayFolder: Detailed Analysis
		lineageTag: 9de27af8-4975-4cc0-9cea-7bfd85014c52

	measure '# Selling Reps' = DISTINCTCOUNT ('Sales Transactions'[OpportunityOwnerID])
		formatString: 0
		displayFolder: Detailed Analysis
		lineageTag: ff46eeb2-2b38-4b8b-851d-d4cd68c7b1e1

	measure '# Accounts Covered' = DISTINCTCOUNT ( 'Sales Transactions'[AccountID] )
		formatString: 0
		displayFolder: Detailed Analysis
		lineageTag: d5cf9f25-d78f-46c7-9be4-3e20820fb701

	measure '$ Quota Gap' = [$ Total Bookings] - [$ Total QuarterlyQuota]
		displayFolder: Detailed Analysis
		lineageTag: 60f24cc4-8a1e-46ce-abfc-9f297f9d2fe3

		formatStringDefinition = "$#,0;-$#,0"

	measure '$ Bookings per Account (by Industry)' = DIVIDE ( [$ Total Bookings], [# Accounts Covered] )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Detailed Analysis
		lineageTag: 0ea2e052-4876-4b93-ab99-3690e2ef05d3

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure '$ Untoched Opportunity' = [$ Bookings per Account] * [# Untouched Accounts]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Detailed Analysis
		lineageTag: 04a7ee63-75ed-4084-8474-77f0ffdf627c

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure '% Untouched Accounts' = [# Untouched Accounts] / [# Total Accounts Base]
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Detailed Analysis
		lineageTag: f89e5f01-bff1-4a26-b157-0b821e4e0282

	measure '$ Bookings per Account (Base)' = DIVIDE ( [$ Total Bookings], [# Total Accounts Base] )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Detailed Analysis
		lineageTag: 303059f4-d898-4391-8085-863128cde665

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure '% of Required Ticket' = DIVIDE ( [$ Bookings per Account (Base)], [$ Quota per Account] )
		formatString: 0%;-0%;0%
		displayFolder: Detailed Analysis
		lineageTag: e1196537-1640-4749-8108-0adc7683b6f2

