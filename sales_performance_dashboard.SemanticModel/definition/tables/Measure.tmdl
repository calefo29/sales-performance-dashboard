	measure '# HHI Product Concentration' = ```
			-- Herfindahl-Hirschman Index
			Var TotalB = CALCULATE ( [$ Total Bookings], ALL ( 'Sales Transactions'[ProductCategory] ) )
			
			RETURN
			    SUMX (
			        ALL('Sales Transactions'[ProductCategory]),
			        VAR SharePct = DIVIDE ( CALCULATE ( [$ Total Bookings] ), TotalB ) * 100
			        RETURN 
			        SharePct * SharePct
			    )
			```
		displayFolder: Detailed Analysis
		lineageTag: ef26908e-80ea-49fc-b18a-6b3ee4e5d135

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '%  HHI Product vs Balance' =
			
			Var N = CALCULATE(DISTINCTCOUNT('Sales Transactions'[ProductCategory]),ALL('Sales Transactions'[ProductCategory]))
			Var PerfectBalance = DIVIDE ( 10000, N )
			RETURN
			    DIVIDE ([# HHI Product Concentration] - PerfectBalance, 10000 - PerfectBalance)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Detailed Analysis
		lineageTag: d1a2a98b-b555-4c36-8da3-8170db7399ee

	measure '@ Portfolio Concentration Status' =
			
			Var Ratio = [%  HHI Product vs Balance]
			
			RETURN
			    SWITCH (
			        TRUE (),
			        Ratio = 0.00, "Perfect Equ.",
			        Ratio < 0.05, "Balanced",
			        Ratio < 0.25, "Moderately Concentrated",
			        Ratio < 1,"Highly concentrated",
			        "Monopoly"
			    )
		displayFolder: Detailed Analysis
		lineageTag: 3b104540-0b07-482a-98d1-3409ad123f33

