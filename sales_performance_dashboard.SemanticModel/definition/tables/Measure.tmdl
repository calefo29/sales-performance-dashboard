	measure '$ Calibrated Quota' =
			
			VAR AllQuarters =CALCULATE (COUNTROWS ( SUMMARIZE ( 'Date Table', 'Date Table'[FiscalYear], 'Date Table'[FiscalQuarter] ) ),REMOVEFILTERS ())
			VAR GlobalRate =DIVIDE (CALCULATE ( [$ Total Bookings], REMOVEFILTERS () ),CALCULATE ( [# Total Accounts Base], REMOVEFILTERS () ) * AllQuarters)
			RETURN
			    GlobalRate * [# Total Accounts Base]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Detailed Analysis
		lineageTag: 7385c9a5-7d2c-4b30-aed0-84e4707389fe

