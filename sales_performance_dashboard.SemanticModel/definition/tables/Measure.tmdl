	measure '$ Total Bookings' = SUM('Sales Transactions'[BookingAmount] )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Measure 2: Quota Attainment %
		lineageTag: 0cc6beda-6900-46c0-adc3-8168114e8d67

	measure '$ Total QuarterlyQuota' = ```
			
			SUMX (
			    SUMMARIZE ( 'Date Table', 'Date Table'[FiscalYear], 'Date Table'[FiscalQuarter]),
			    VAR 
			        QuarterStart = CALCULATE(MIN ('Date Table'[Date] ),ALLEXCEPT ( 'Date Table', 'Date Table'[FiscalYear], 'Date Table'[FiscalQuarter]))
			    RETURN
			        CALCULATE (SUM ( 'Sales Reps'[QuarterlyQuota]),'Sales Reps'[HireDate] <= QuarterStart)
			)
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Measure 2: Quota Attainment %
		lineageTag: db2248dd-f15c-46fa-a245-70be1097979f

	measure '% Quota Attainment' = DIVIDE ( [$ Total Bookings], [$ Total QuarterlyQuota] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Measure 2: Quota Attainment %
		lineageTag: 92303aac-8e7f-4524-b563-33a83901e330

	measure '# Accounts Chur. 12m (Spec)' =
			
			VAR RefDate  = MAX ('Date Table'[Date])
			VAR LimitDate = EDATE (RefDate, -12)
			RETURN
			    CALCULATE (DISTINCTCOUNTNOBLANK(Accounts[AccountID]), Accounts[ChurnDate] > LimitDate, Accounts[ChurnDate] <= RefDate)
		formatString: #,0
		displayFolder: Measure 3: Rolling 12-Month Churn Rate
		lineageTag: 7b5cabb7-d61a-4d77-9dfd-e618b264f031

	measure '# Active Acc (Spec)' =
			
			VAR RefDate  = MAX ('Date Table'[Date])
			return
			CALCULATE(DISTINCTCOUNTNOBLANK(Accounts[AccountID]),Accounts[IsChurned]=0)
		formatString: #,0
		displayFolder: Measure 3: Rolling 12-Month Churn Rate
		lineageTag: 5269b5b0-4a5f-4b4f-83a3-d1a55d40cce7

	measure '% Churn Rate 12M (Spec)' = DIVIDE([# Accounts Chur. 12m (Spec)], [# Active Acc (Spec)] + [# Accounts Chur. 12m (Spec)])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Measure 3: Rolling 12-Month Churn Rate
		lineageTag: 3d1b6b75-7464-4302-a3bf-98add5747abc

	measure '# Active Acc (Cohort)' =
			
			VAR DateRef = MAX('Date Table'[Date])
			VAR LimitDate = EDATE(DateRef, -12)
			RETURN
			    CALCULATE (
			        DISTINCTCOUNTNOBLANK(Accounts[AccountID]),
			        Accounts[FirstPurchaseDate] <= LimitDate,
			        FILTER (ALL(Accounts[ChurnDate]),
			            ISBLANK ( Accounts[ChurnDate] ) || Accounts[ChurnDate] > LimitDate)
			    )
		formatString: #,0
		displayFolder: Measure 3: Rolling 12-Month Churn Rate
		lineageTag: 27aa0ba7-b723-4979-857f-fa59e196964a

	measure '# Accounts Chur. 12m (Cohort)' =
			
			VAR RefDate  = MAX ('Date Table'[Date])
			VAR LimitDate = EDATE (RefDate, -12)
			RETURN
			    CALCULATE (DISTINCTCOUNTNOBLANK(Accounts[AccountID]), Accounts[FirstPurchaseDate] <= LimitDate, Accounts[ChurnDate] > LimitDate, Accounts[ChurnDate] <= RefDate)
		formatString: #,0
		displayFolder: Measure 3: Rolling 12-Month Churn Rate
		lineageTag: 07e89533-6202-4c18-af33-8264e7e00e32

	measure '% Churn Rate 12M (Cohort)' = DIVIDE([# Accounts Chur. 12m (Cohort)], [# Active Acc (Cohort)])
