	measure '$ Net New ARR' =
			CALCULATE(SUM('Sales Transactions'[BookingAmount] ),FILTER(all('Sales Transactions'[DealType]),'Sales Transactions'[DealType] IN {"New Business","Expansion","Contraction"}))
			
			-- Blacklist model
			--CALCULATE(sum('Sales Transactions'[BookingAmount]),FILTER(all('Sales Transactions'[DealType]),'Sales Transactions'[DealType]<>"Renewal"))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
